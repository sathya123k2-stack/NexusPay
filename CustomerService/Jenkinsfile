pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Begin') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        dotnet sonarscanner begin \
                          /k:"NexusPay" \
                          /d:sonar.host.url="$SONAR_HOST_URL" \
                          /d:sonar.token="$SONAR_AUTH_TOKEN"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh 'dotnet restore NexusPay.sln'

                dir('CustomerService') {
                    sh 'dotnet build --configuration Release --no-restore'
                }
            }
        }

        stage('Test') {
            steps {
                sh 'dotnet test --configuration Release --no-restore'
            }
        }

        stage('SonarQube End') {
    steps {
        withSonarQubeEnv('SonarQube') {
            sh '''
                dotnet sonarscanner end \
                  /d:sonar.token="$SONAR_AUTH_TOKEN"
            '''
        }
    }
}

stage('Quality Gate') {
    steps {
        timeout(time: 5, unit: 'MINUTES') {
            waitForQualityGate abortPipeline: true
        }
    }
}


        stage('Docker Build') {
            steps {
                dir('CustomerService') {
                    sh 'docker build -t nexuspay-customerservice:latest .'
                }
            }
        }
    }
}